# Variables lues par l'API à M0. Aucun secret ici.
CENTRADE_LOG_LEVEL=INFO
# Compose core : Caddy est le seul service publié sur l'hôte.
CENTRADE_BIND_ADDR=127.0.0.1
CENTRADE_HTTPS_PORT=8443
CENTRADE_HOSTNAME=localhost
# Les secrets (mots de passe Postgres et Redis, clé maître) ne vont jamais ici : `make secrets`
# les génère dans secrets/ (Docker secrets). Réseau edge fixe : 172.31.250.0/24 (core.yml).
