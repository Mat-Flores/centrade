# Copy to .env (never commit .env). Generate a password with: openssl rand -base64 24

# Dashboard admin password, set before the first boot (otherwise the default is "CHANGEME").
INITIAL_PASSWORD=

# Every request needs an API key or dashboard login.
REQUIRE_API_KEY=true

# V8 memory ceiling in MB; keep below mem_limit in docker-compose.yml.
OMNIROUTE_MEMORY_MB=2048

# Pin a released version instead of "latest" once you have one that works.
# OMNIROUTE_TAG=latest
